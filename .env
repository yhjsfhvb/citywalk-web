# ============================================================================
#  uniCloud 云对象 URL 化地址
# ----------------------------------------------------------------------------
#  在 HBuilderX 中把云对象 citywalk-api 上传到云空间后，打开
#  「uniCloud 控制台 -> 云函数/云对象 -> citywalk-api -> URL 化」，
#  配置触发路径为 /citywalk-api（与云函数内 common/config.js 的 urlPath 一致），
#  把控制台给出的完整域名 + 路径填写到下方，例如：
#      VITE_UNICLOUD_URL=https://xxxxxx.bspapp.com/http/citywalk-api
#  注意：修改本文件后必须重新执行 npm run build 才会生效。
# ============================================================================
VITE_UNICLOUD_URL=https://env-00jy6ydc5c68.dev-hz.cloudbasefunction.cn/citywalk-api
